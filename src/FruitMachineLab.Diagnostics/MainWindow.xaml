<Window x:Class="FruitMachineLab.Diagnostics.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FruitMachineLab — Skill Cash diagnostics" Width="1100" Height="850" MinWidth="800" MinHeight="650">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock FontSize="24" Text="Adders &amp; Ladders: Skill Cash" />
   <TextBlock Margin="0,10" TextWrapping="Wrap" Text="Live mode executes the recovered board selection and Skill Cash feature with physical Take/Start inputs. Verified playback remains separate. Audio and full machine startup are outside this slice." />
   <TextBlock Text="Repository folder" /><TextBox x:Name="RootPath" Margin="0,5" />
   <Button x:Name="LoadReplay" Content="Load verified playback / scrubber" Click="Replay" HorizontalAlignment="Left" Padding="12,7" Margin="0,5" />
   <TextBlock x:Name="Status" Margin="0,10" TextWrapping="Wrap" />
  </StackPanel>
  <TabControl x:Name="Views" SelectionChanged="ViewChanged">
   <TabItem Header="Live Skill Cash">
    <DockPanel Margin="12">
     <StackPanel DockPanel.Dock="Top">
      <WrapPanel>
       <Button x:Name="BeginLiveButton" Content="Start feature" Click="BeginLive" Padding="14,7" />
       <Button x:Name="PauseLiveButton" Content="Pause execution" Click="PauseLiveClick" IsEnabled="False" Padding="14,7" Margin="8,0" />
       <Button x:Name="ResumeLiveButton" Content="Resume execution" Click="ResumeLiveClick" IsEnabled="False" Padding="14,7" />
       <Button x:Name="RestartLiveButton" Content="Restart feature" Click="BeginLive" IsEnabled="False" Padding="14,7" Margin="8,0" />
      </WrapPanel>
      <ComboBox x:Name="LiveEntryMode" SelectedIndex="2" Margin="0,8,0,0" HorizontalAlignment="Left" MinWidth="360" ToolTip="Applied on Start feature or Restart. Each mode starts at a captured boundary; full machine startup is not included.">
       <ComboBoxItem Content="Skill Cash entry (C721)" /><ComboBoxItem Content="Taken board result (E2FC)" /><ComboBoxItem Content="Board selection: Take Skill Cash (DD38)" />
      </ComboBox>
      <TextBlock x:Name="SessionDiagnostic" Text="Start the feature, then hold and release the physical START button below." Margin="0,10" TextWrapping="Wrap" FontFamily="Consolas" />
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock x:Name="SessionAlpha" Text="                " FontFamily="Consolas" FontSize="32" Background="#14221A" Foreground="#BCF6C9" Padding="12" />
       <WrapPanel Margin="0,12">
        <Button x:Name="PhysicalStart" Content="START" IsEnabled="False" Padding="32,15" FontSize="20" FontWeight="Bold"
         PreviewMouseLeftButtonDown="PhysicalStartDown" PreviewMouseLeftButtonUp="PhysicalStartUp" LostMouseCapture="PhysicalStartCaptureLost"
         PreviewKeyDown="PhysicalStartKeyDown" PreviewKeyUp="PhysicalStartKeyUp" LostKeyboardFocus="PhysicalStartFocusLost" />
        <Button x:Name="PhysicalTake" Content="TAKE FEATURE" IsEnabled="False" Padding="16,15" Margin="8,0" FontSize="18" FontWeight="Bold"
         PreviewMouseLeftButtonDown="PhysicalTakeDown" PreviewMouseLeftButtonUp="PhysicalTakeUp" LostMouseCapture="PhysicalTakeCaptureLost" LostKeyboardFocus="PhysicalTakeFocusLost"
         PreviewKeyDown="PhysicalTakeKeyDown" PreviewKeyUp="PhysicalTakeKeyUp" />
        <TextBlock Margin="16,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="Momentary buttons • mouse or Space/Enter while focused&#10;START: BLACK2 bit 80 • TAKE: BLACK2 bit 01" />
       </WrapPanel>
       <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="Board selection: TAKE FEATURE chooses Skill Cash (BLACK2 bit 01). START runs one dice roll, then stops before board movement. In Skill Cash, START stops each selection." />
       <TextBlock x:Name="SessionAccounting" Margin="0,0,0,10" Text="Pending 0 • current win 0 ROM units" />
       <TextBlock x:Name="SessionDice" Margin="0,0,0,8" TextWrapping="Wrap" />
       <TextBlock x:Name="SessionDiceFace" Margin="0,0,0,8" FontSize="28" FontFamily="Consolas" />
       <TextBlock Text="Selection feedback — recovered lamp groups" FontWeight="SemiBold" />
       <UniformGrid x:Name="SessionSelectionLamps" Columns="6" Margin="0,8" />
       <TextBlock Text="Skill Cash lamps — diagnostic arrangement" FontWeight="SemiBold" />
       <UniformGrid x:Name="SessionFeatureLamps" Columns="8" Margin="0,8" />
       <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Text="VM state, input sampling, lamps and alpha are live. CPU dispatch pacing and IRQ service latency still use captured timing adapters. Other panel inputs are idle; entry DIL/options are fixed prerequisites. Lamp persistence is a display aid." />
       <Expander Header="All mapped lamps (MAME number / ROM command)">
        <UniformGrid x:Name="SessionAllLamps" Columns="8" />
       </Expander>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </TabItem>
   <TabItem Header="Skill Cash playback">
    <DockPanel Margin="12">
     <StackPanel DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal">
       <Button x:Name="PlayButton" Content="Play" Click="PlayPlayback" IsEnabled="False" Padding="16,6" />
       <Button x:Name="PauseButton" Content="Pause" Click="PausePlayback" IsEnabled="False" Padding="16,6" Margin="8,0" />
       <Button x:Name="RestartButton" Content="Restart" Click="RestartPlayback" IsEnabled="False" Padding="16,6" />
       <TextBlock Text="Speed" VerticalAlignment="Center" Margin="18,0,8,0" />
       <ComboBox x:Name="PlaybackSpeed" SelectedIndex="2" SelectionChanged="SpeedChanged" Width="85">
        <ComboBoxItem Content="0.25×" Tag="0.25" /><ComboBoxItem Content="0.5×" Tag="0.5" /><ComboBoxItem Content="1×" Tag="1" /><ComboBoxItem Content="2×" Tag="2" /><ComboBoxItem Content="4×" Tag="4" />
       </ComboBox>
       <TextBlock x:Name="PlaybackTime" Text="Load the feature to begin" VerticalAlignment="Center" Margin="18,0,0,0" />
      </StackPanel>
      <Slider x:Name="PlaybackPosition" Minimum="0" Maximum="1" ValueChanged="SeekPlayback" IsEnabled="False" Margin="0,12" IsMoveToPointEnabled="True" />
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
      <TextBlock x:Name="LiveAlpha" Text="                " FontFamily="Consolas" FontSize="32" Background="#14221A" Foreground="#BCF6C9" Padding="12" />
      <TextBlock x:Name="LiveAccounting" Margin="0,8" Text="Recorded input path • no player input required" />
      <TextBlock Text="Skill Cash award strip — diagnostic arrangement" FontWeight="SemiBold" />
      <UniformGrid x:Name="FeatureLamps" Columns="8" Margin="0,8" />
      <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Text="Lamps show verified scan/callback output through 20 ms of display persistence. Captions come from the recovered MAME mapping; numbered tiles below are a diagnostic layout, not cabinet artwork. ? means the caption is unresolved." />
       <TextBlock Text="All 128 mapped lamps (MAME number / ROM command)" FontWeight="SemiBold" Margin="0,4" />
       <UniformGrid x:Name="AllLamps" Columns="8" />
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </TabItem>
   <TabItem Header="Verification">
    <DataGrid x:Name="Events" IsReadOnly="True" AutoGenerateColumns="True" />
   </TabItem>
   <TabItem Header="Alpha display timeline">
    <DockPanel Margin="12">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock TextWrapping="Wrap" Text="Recovered 16-cell software shadow in cursor order. Decimal points attach to the prior cell. Clock values are recorded scheduler observations; this is not an electrical VFD simulation." />
      <TextBox x:Name="AlphaPreview" IsReadOnly="True" FontFamily="Consolas" FontSize="28" Background="#14221A" Foreground="#BCF6C9" Padding="12" Margin="0,10" />
     </StackPanel>
     <DataGrid x:Name="AlphaTimeline" IsReadOnly="True" AutoGenerateColumns="True" SelectionChanged="AlphaSelected" />
    </DockPanel>
   </TabItem>
   <TabItem Header="IRQ output scan">
    <DockPanel Margin="12">
     <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap" Text="VM-generated lamp writes, IRQ scans and timer callbacks share one memory model. The rows show calculated latches at captured CPU-cycle offsets. Timer deadlines, electrical edges and visible brightness are not simulated." />
     <DataGrid x:Name="ScanTimeline" IsReadOnly="True" AutoGenerateColumns="True" />
    </DockPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
