<Window x:Class="FruitMachineLab.Diagnostics.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FruitMachineLab — Skill Cash diagnostics" Width="860" Height="480">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock FontSize="24" Text="Adders &amp; Ladders: Skill Cash" />
   <TextBlock Margin="0,10" TextWrapping="Wrap" Text="Continuous C721 feature replay: selection, compensation, RNG, award transfer, NVRAM and caller-frame cleanup. IRQ/latch timing and physical input-port observations are recorded. Lamp frame buffers and sound timing are verified; physical lamp scanning, alpha-display effects and audio synthesis remain incomplete." />
   <TextBlock Text="Repository folder" /><TextBox x:Name="RootPath" Margin="0,5" />
   <Button Content="Verify continuous Skill Cash replay" Click="Replay" HorizontalAlignment="Left" Padding="12,7" Margin="0,5" />
   <TextBlock x:Name="Status" Margin="0,10" TextWrapping="Wrap" />
  </StackPanel>
  <DataGrid x:Name="Events" IsReadOnly="True" AutoGenerateColumns="True" />
 </DockPanel>
</Window>
